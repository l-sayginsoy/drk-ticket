rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         (request.auth.token.email == "sayginsoy1978@gmail.com" && request.auth.token.email_verified == true));
    }

    // Check if the user is a technician
    function isTechnician() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'techniker';
    }

    // Check if the user is staff (admin or technician)
    function isStaff() {
      return isAdmin() || isTechnician();
    }

    // Ticket lifecycle only: preserve the existing login/access model.
    // Each ticket document has id:string and status:string. Completed copies live
    // in completed_tickets; intentional reopen moves them atomically to active.
    function isValidTicket(ticketId) {
      return request.resource.data.id == ticketId
        && request.resource.data.status in ['Offen', 'In Arbeit', 'Überfällig', 'Abgeschlossen', 'Zurückgestellt'];
    }

    function canWriteActiveTicket(ticketId) {
      // The closed-status exception lets old clients finish their legacy close
      // sequence. Their stale OPEN/OVERDUE writes must never revive an archive.
      return isValidTicket(ticketId) &&
        (request.resource.data.status == 'Abgeschlossen' ||
         !existsAfter(/databases/$(database)/documents/completed_tickets/$(ticketId)));
    }

    function isReopenedAt(collectionName, ticketId) {
      let path = /databases/$(database)/documents/$(collectionName)/$(ticketId);
      return existsAfter(path) && getAfter(path).data.status != 'Abgeschlossen'
        && getAfter(path).data.get('is_reopened', false) == true;
    }

    function canRemoveCompletedTicket(ticketId) {
      // Old clients must not delete the archive after a rejected stale reopen.
      // Deliberate deletion keeps the existing cross-device deletion blocklist.
      let deleted = /databases/$(database)/documents/app_data/deleted-ticket-ids;
      return isReopenedAt('tickets', ticketId) || isReopenedAt('routine_tickets', ticketId)
        || (existsAfter(deleted) && ticketId in getAfter(deleted).data.value);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users Collection
    match /users/{userId} {
      // Anyone can read users (needed for portal dropdowns and login)
      allow read: if true;
      // Only admins can create/update/delete users
      allow write: if isAdmin();
    }

    // Locations Collection
    match /locations/{locationId} {
      // Anyone can read locations (needed for portal dropdowns)
      allow read: if true;
      // Only admins can modify locations
      allow write: if isAdmin();
    }

    // Active Tickets Collection
    match /tickets/{ticketId} {
      allow read, delete: if true;
      allow create, update: if canWriteActiveTicket(ticketId);
    }

    // Completed Tickets Collection
    match /completed_tickets/{ticketId} {
      allow read: if true;
      allow create, update: if isValidTicket(ticketId) && request.resource.data.status == 'Abgeschlossen';
      allow delete: if canRemoveCompletedTicket(ticketId);
    }

    // Routine Tickets Collection (active series/routine tickets)
    match /routine_tickets/{ticketId} {
      allow read, delete: if true;
      allow create, update: if canWriteActiveTicket(ticketId);
    }

    // Assets Collection
    match /assets/{assetId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Maintenance Plans Collection
    match /maintenancePlans/{planId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // App Data Collection (for seamless migration from Supabase)
    match /app_data/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Events Collection (Veranstaltungen)
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
